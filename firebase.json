{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "catacroket-2b047",
          "appId": "1:309754906133:android:7edca45cc10efb5257f01c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "catacroket-2b047",
          "appId": "1:309754906133:ios:0aa9eabca1fa0ada57f01c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "catacroket-2b047",
          "configurations": {
            "android": "1:309754906133:android:7edca45cc10efb5257f01c",
            "ios": "1:309754906133:ios:0aa9eabca1fa0ada57f01c"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'"
          }
        ]
      }
    ]
  }
}
