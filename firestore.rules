rules_version = '2';

// Quién puede leer y escribir qué.
//
// Esto NO es una formalidad: es lo único que impide que cualquiera con la
// app instalada lea las catas de una mesa que no es suya. En el plan Spark
// no hay Cloud Functions, así que aquí no hay red de seguridad detrás: lo
// que no prohíba este fichero, pasa.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    // ── Tu ficha ────────────────────────────────────────────────────────
    // La leen los demás miembros de tus mesas para poner tu nombre en las
    // catas; escribirla, sólo tú.
    //
    // `get` sí y `list` NO. Con `read` a secas —que es `get` MÁS `list`—
    // cualquiera con una cuenta podía pedir la colección entera y bajarse el
    // nombre de todos los usuarios de Catacroket. El comentario decía «la
    // leen los miembros de tus mesas», pero la regla no comprobaba ninguna
    // mesa. Ahora sólo se puede preguntar por un identificador que ya
    // conoces, y los únicos que conoces son los de tu propia gente.
    match /usuarios/{uid} {
      allow get: if conSesion();
      allow list: if false;
      allow write: if conSesion() && request.auth.uid == uid;
    }

    // ── Códigos de mesa ─────────────────────────────────────────────────
    // Un código de seis letras sirve para entrar en una mesa que todavía no
    // es tuya, así que hay que poder leerlo sin ser miembro.
    //
    // `get` sí y `list` NO, y la diferencia importa: con `list` cualquiera
    // se descargaría la colección entera y tendría todos los códigos de
    // todas las mesas. Así sólo puedes comprobar uno que ya conoces, que es
    // justo lo que hace falta.
    match /codigos/{codigo} {
      allow get: if conSesion();
      allow list: if false;
      allow create: if conSesion()
                    && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Mesas ───────────────────────────────────────────────────────────
    match /mesas/{mesaId} {

      function esMiembro() {
        return conSesion() && request.auth.uid in resource.data.miembros;
      }

      allow get, list: if esMiembro();

      allow create: if conSesion()
                    && request.resource.data.creadoPor == request.auth.uid
                    && request.auth.uid in request.resource.data.miembros;

      function laCreo() {
        return conSesion() && resource.data.creadoPor == request.auth.uid;
      }

      function tocadas() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Tres formas de modificar una mesa:
      //
      // 1. Eres miembro: puedes tocar el nombre, la descripción, el color y
      //    el código. NO la lista de gente ni quién la creó. Antes esto era
      //    `esMiembro()` a secas, sin restringir un solo campo, y el agujero
      //    era de los gordos: cualquiera a quien le reenviaran el código
      //    podía escribir `miembros: [suUid], creadoPor: suUid`, dejarte
      //    fuera de tu propia mesa —y sin acceso a tus catas, porque la
      //    lectura también mira esa lista— y acto seguido borrarla entera.
      // 2. La creaste tú: además puedes cambiar la lista de gente, que es
      //    lo que hace falta para invitar o echar a alguien.
      // 3. Estás entrando con el código. Lo ÚNICO permitido es añadirte a ti
      //    mismo al final de la lista, y nada más.
      // 4. Te sales tú: quitarte de la lista y nada más. Faltaba, y sin ella
      //    nadie podía abandonar una mesa: la borrabas de tu móvil y volvía
      //    sola al siguiente arranque, porque el servidor te seguía teniendo
      //    dentro y «las mesas donde estoy» te la devolvía.
      allow update: if
                    (esMiembro() && !tocadas().hasAny(['miembros', 'creadoPor', 'creada']))
                    || (laCreo() && tocadas().hasOnly(['miembros']))
                    || (
                      esMiembro()
                      && tocadas().hasOnly(['miembros'])
                      && !(request.auth.uid in request.resource.data.miembros)
                    )
                    || (
                      conSesion()
                      && tocadas().hasOnly(['miembros'])
                      && request.resource.data.miembros
                           == resource.data.miembros.concat([request.auth.uid])
                    );

      // Borrar la mesa entera, sólo quien la creó. Que un invitado pueda
      // borrarle la libreta a los demás no tiene ningún sentido.
      allow delete: if laCreo();

      // ── Las catas de esa mesa ─────────────────────────────────────────
      match /catas/{cataId} {

        function miembroDeLaMesa() {
          return conSesion()
                 && request.auth.uid in
                    get(/databases/$(database)/documents/mesas/$(mesaId))
                      .data.miembros;
        }

        // Las lee todo el grupo: de eso va compartir.
        allow read: if miembroDeLaMesa();

        // Pero cada uno sólo escribe las suyas. Sin esto, cualquiera del
        // grupo podría cambiarle la nota a la cata de otro.
        allow create: if miembroDeLaMesa()
                      && request.resource.data.autorUid == request.auth.uid;

        // Y al corregirla no se puede cambiar de autor: sin esto, quien
        // edita su propia cata podría ponerle el uid de otro y dejarla
        // fuera de su alcance para siempre.
        allow update: if miembroDeLaMesa()
                      && resource.data.autorUid == request.auth.uid
                      && request.resource.data.autorUid == request.auth.uid;

        allow delete: if miembroDeLaMesa()
                      && resource.data.autorUid == request.auth.uid;
      }
    }
  }
}
