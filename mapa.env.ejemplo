# Configuración del mapa para las compilaciones de tienda.
#
# Copia esto a `mapa.env` (que está en .gitignore) y pon la clave de CARTO.
# Se pide gratis en https://carto.com/basemaps/apikey/ : no hace falta cuenta
# y llega por correo en un minuto. Gratis hasta 5M de teselas al mes para uso
# no comercial y 1M para uso comercial.
#
# Luego:  herramientas/empaquetar.sh android
#         herramientas/empaquetar.sh ios

CATACROKET_TESELAS='https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
CATACROKET_MAPA_CLAVE=LA-CLAVE-DE-CARTO
CATACROKET_MAPA_CREDITO='© OpenStreetMap · © CARTO'

# CARTO pide la clave como `key`. Stadia, MapTiler y Thunderforest la piden
# como `api_key`; si algún día se cambia de proveedor, se ajusta aquí.
CATACROKET_MAPA_PARAM=key
